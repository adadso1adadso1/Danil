name: Build APK
on: [push]
jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      - name: Install deps
        run: |
          sudo apt-get update
          sudo apt-get install -y git zip unzip openjdk-17-jdk python3-pip autoconf libtool pkg-config zlib1g-dev libncurses5-dev libncursesw5-dev libtinfo5 cmake libffi-dev libssl-dev
          pip install --user buildozer cython
      - name: Build APK
        run: |
          export PATH=$PATH:~/.local/bin
          export MAKEFLAGS="-j2"
          export GRADLE_OPTS="-Dorg.gradle.jvmargs=-Xmx2048m"
          yes | buildozer -v android debug
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: lada-apk
          path: bin/*.apk
